<Project Sdk="Microsoft.NET.Sdk">
  <!--
    Pure logic with no Unity/BepInEx/Valheim references, so it can be unit tested outside the game.
    The plugin compiles these sources directly into ControllerGlyphFixer.dll (see the plugin csproj),
    so only one DLL is deployed. Keep the code netstandard2.0 / C# 10 compatible.
  -->
  <PropertyGroup>
    <TargetFramework>netstandard2.0</TargetFramework>
    <LangVersion>10</LangVersion>
    <RootNamespace>ControllerGlyphFixer.Core</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <!-- Same version as the shared ValheimModding-YamlDotNet package (assembly version 16.0.0) -->
    <PackageReference Include="YamlDotNet" Version="16.3.0" />
  </ItemGroup>
</Project>
